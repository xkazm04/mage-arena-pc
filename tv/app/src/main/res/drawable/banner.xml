<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher banner (320x180). Placeholder until a painted banner exists. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <gradient android:angle="270" android:startColor="#1b2a2f" android:endColor="#0b1114" />
        </shape>
    </item>
    <item android:left="40dp" android:right="40dp" android:top="84dp" android:bottom="84dp">
        <shape android:shape="rectangle">
            <solid android:color="#5fc4d8" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
