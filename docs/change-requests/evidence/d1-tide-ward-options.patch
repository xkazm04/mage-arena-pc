@@ -0,0 +1,28 @@
+// D1 6.4 Tide Ward probe (part of the declined-options patch): at the start of every aimed beam on the Mirror tide reference,
+// can it afford Tide Ward (mana) and is its mend line off cooldown? Runs with option A (held) planted.
+import { createGames, presets, runtime, stepGames, threats, ticks } from '../src/arena/index.ts';
+import { rivalBuilds } from '../src/arena/archetypes.ts';
+import { tideWard, withCounterRule } from '../src/arena/counters.ts';
+const out: Record<string, unknown> = {};
+withCounterRule({ tideWardHeld: true }, () => {
+  for (const id of ['fire_heavy', 'air_close', 'air_heavy']) {
+    let beams = 0, mana = 0, free = 0, both = 0; const manas: number[] = [];
+    for (let i = 0; i < 200; i++) {
+      const g = createGames(runtime.games.censusSeedStart + i, presets.find(p => p.name === 'Mirror tide')!, rivalBuilds[id]!.wave, true, undefined, undefined, undefined, { rivalBuild: id });
+      let inBeam = false;
+      while (g.phase === 'active' && g.state.tick < ticks(runtime.games.fightTimeoutS)) {
+        stepGames(g);
+        const beam = threats(g.state, g.player).some(t => t.shape === 'beam' && t.aimedAtUs);
+        if (beam && !inBeam) {
+          beams++; manas.push(g.player.mana);
+          const ok = g.player.mana >= tideWard.mana, off = (g.player.water.cooldowns[tideWard.line] ?? 0) <= g.state.tick;
+          mana += +ok; free += +off; both += +(ok && off);
+        }
+        inBeam = beam;
+      }
+    }
+    manas.sort((a, b) => a - b);
+    out[id] = { beams, affordable: mana, mendLineFree: free, both, medianMana: manas[Math.floor(manas.length / 2)] ?? null };
+  }
+});
+console.log(JSON.stringify({ tideWardMana: tideWard.mana, seeds: 200, ...out }, null, 2));
