+// Water's beam answer (D1 4.2, docs/concepts/D1-combat-followup-and-progression.md section 6.4). Tide Ward (mend II) is the
+// shape-class answer to a beam (mage-ai.ts), but a Water line plays one row per collar tier, so Tide Ward is gone by the
+// time the beams (Brand Wrath, Cyclone: tier IV) come. D1 names two ways out, both built here and driven by the PC overlay
+// (school-balance.pc.json `counters`):
+// - `tideWardHeld` (option A, the answer moves to a row Water has early): from tier III on, while an enemy beam runs, the
+//   mend line's slot plays Tide Ward, the row the line had at tier II (its own numbers, its own line cooldown).
+// - `tideWardAnswers` (option B, a second answer class): the shape classes a Water defender facing a build casts Tide Ward
+//   against. ['beam'] is today's rule.
+// Gate: a state that runs balance 'canonical' (CR-002/CR-007 parity) reads neither, and both need an enemy build or beam,
+// so Water-only states (goldens, the default census) step exactly as before.
+// Imports stay leaf-ward (data, catalog, tuning, types) so water.ts and mage-ai.ts can read it.
+import balance from './data/school-balance.pc.json' with { type: 'json' };
+import { spellFor, spells, type Spell } from './catalog.ts';
+import { adjustedSpell } from './tuning.ts';
+import type { ShapeClass } from './mage-ai.ts';
+import type { Actor, ArenaState } from './types.ts';
+
+export interface CounterRule { tideWardHeld: boolean; tideWardAnswers: ShapeClass[] }
+const shapeClasses: readonly ShapeClass[] = ['projectile', 'beam', 'close', 'area', 'line'];
+const ruleKeys = ['tideWardHeld', 'tideWardAnswers'] as const;
+/** Problems with a `counters` block: exactly the rule's keys; answers a non-empty list of distinct shape classes that keeps 'beam'. Absent is valid (today's rule). */
+export function counterProblems(candidate: unknown): string[] {
+  if (candidate === undefined) return [];
+  if (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) return ['school-balance.pc.json counters: not an object'];
+  const have = Object.keys(candidate), value = candidate as Record<string, unknown>;
+  const out = [...have.filter(k => !(ruleKeys as readonly string[]).includes(k)).map(k => `school-balance.pc.json counters: unknown key ${k}`),
+    ...ruleKeys.filter(k => !have.includes(k)).map(k => `school-balance.pc.json counters: missing ${k}`)];
+  if (have.includes('tideWardHeld') && typeof value.tideWardHeld !== 'boolean') out.push('school-balance.pc.json counters.tideWardHeld must be true or false');
+  const answers = value.tideWardAnswers;
+  if (have.includes('tideWardAnswers') && (!Array.isArray(answers) || !answers.includes('beam') || new Set(answers).size !== answers.length || answers.some(c => !(shapeClasses as readonly unknown[]).includes(c))))
+    out.push(`school-balance.pc.json counters.tideWardAnswers must list distinct shape classes (${shapeClasses.join(', ')}) and keep beam`);
+  return out;
+}
+const loaded = (balance as { counters?: unknown }).counters;
+const loadErrors = counterProblems(loaded);
+if (loadErrors.length) throw Error(loadErrors.join(' '));
+/** The overlay's rule, one shared object (tests and the census plant variants on it). */
+export const counterRule: CounterRule = loaded ? { ...(loaded as CounterRule) } : { tideWardHeld: false, tideWardAnswers: ['beam'] };
+/** Run `body` with `variant` planted on the rule (a census arm; nothing else changes). */
+export function withCounterRule<T>(variant: Partial<CounterRule>, body: () => T): T {
+  const saved = { ...counterRule };
+  Object.assign(counterRule, variant);
+  try { return body(); } finally { Object.assign(counterRule, saved); }
+}
+
+/** Tide Ward, the Water row that answers beams. */
+export const tideWard: Spell = spells.find(s => s.effect === 'ward')!;
+/** The classes a Water defender facing a build casts Tide Ward against (['beam'] under canonical balance). */
+export const tideWardAnswers = (state: ArenaState): readonly ShapeClass[] => state.balance === 'canonical' ? ['beam'] : counterRule.tideWardAnswers;
+const enemyBeam = (state: ArenaState, a: Actor): boolean => (state.schoolEffects ?? []).some(e => e.kind === 'beam' && e.endTick >= state.tick
+  && state.actors.find(o => o.id === e.ownerId)?.team !== a.team);
+/** The row a Water actor's slot plays now: spellFor's tier row, except that the held Tide Ward (option A) takes the mend
+ * line's slot past tier II while an enemy beam runs. */
+export function waterSlotSpell(a: Actor, slot: number, state?: ArenaState): Spell | undefined {
+  if (state && counterRule.tideWardHeld && state.balance !== 'canonical' && !a.schoolState && slot > 0
+    && a.water.composition.lines[slot - 1] === tideWard.line && a.tier > tideWard.tier && enemyBeam(state, a)) return adjustedSpell(tideWard, a, state);
+  return spellFor(a, slot, state);
+}
