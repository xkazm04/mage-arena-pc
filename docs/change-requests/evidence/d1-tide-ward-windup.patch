+// The Water beam-answer rule (counters.ts, D1 6.4-6.5): the overlay block is checked at load, the held Tide Ward takes the
+// mend slot only past tier II while an enemy beam runs, and the bank keeps Tide Ward's mana and line while a beam build's
+// beam row is open, and the windup cue raises the ward at a beam's windup, never at a channel alone. Parity (balance canonical)
+// reads none of them.
+import { describe, expect, it } from 'vitest';
+import { presets } from './catalog.ts';
+import { createGames } from './games.ts';
+import { combat } from './kernel.ts';
+import { mageInput } from './mage-ai.ts';
+import { facesOpenBeam, rivalBuilds } from './archetypes.ts';
+import { counterProblems, counterRule, tideWard, tideWardAtWindup, tideWardBankable, waterSlotSpell, withCounterRule } from './counters.ts';
+import { ticks } from './kernel.ts';
+import type { Actor } from './types.ts';
+
+const mirror = presets.find(p => p.name === 'Mirror tide')!, mendSlot = 1 + mirror.lines.indexOf('mend');
+const buildGames = (id: string) => {
+  const g = createGames(41000, mirror, rivalBuilds[id]!.wave, true, undefined, undefined, undefined, { rivalBuild: id });
+  return { g, rival: g.state.actors.find(a => a.team !== g.player.team)! };
+};
+const place = (a: Actor, x: number, y: number) => { a.pos = { x, y }; a.previousPos = { x, y }; };
+
+describe('counters overlay block', () => {
+  it('ships every rule off and rejects unknown, missing or non-boolean keys', () => {
+    expect(counterRule).toEqual({ tideWardHeld: false, tideWardBank: false, tideWardWindup: false });
+    expect(counterProblems(undefined)).toEqual([]);
+    expect(counterProblems({ tideWardHeld: true, tideWardBank: false, tideWardWindup: true })).toEqual([]);
+    expect(counterProblems({ tideWardHeld: true, tideWardBank: false })).toEqual(['school-balance.pc.json counters: missing tideWardWindup']);
+    expect(counterProblems({ tideWardHeld: 1, tideWardBank: false, tideWardWindup: false, extra: true })).toHaveLength(2);
+    expect(counterProblems([])).toHaveLength(1);
+  });
+});
+
+describe('held Tide Ward (6.4 option A)', () => {
+  it('plays the mend slot past tier II only while an enemy beam runs, and never under canonical balance', () => {
+    const { g, rival } = buildGames('fire_heavy'), s = g.state;
+    g.player.tier = 4;
+    s.schoolEffects = [{ kind: 'beam', ownerId: rival.id, endTick: s.tick + 10 } as never];
+    expect(waterSlotSpell(g.player, mendSlot, s)!.effect).toBe('font');
+    withCounterRule({ tideWardHeld: true }, () => {
+      expect(waterSlotSpell(g.player, mendSlot, s)!.id).toBe(tideWard.id);
+      s.balance = 'canonical'; expect(waterSlotSpell(g.player, mendSlot, s)!.effect).toBe('font'); s.balance = undefined;
+      s.schoolEffects = []; expect(waterSlotSpell(g.player, mendSlot, s)!.effect).toBe('font');
+    });
+  });
+});
+
+describe('Tide Ward bank (6.5)', () => {
+  it('reads an open beam row off the build and its collar', () => {
+    const { g, rival } = buildGames('fire_heavy');
+    rival.tier = 3; expect(facesOpenBeam(g.state, g.player)).toBe(false);
+    rival.tier = 4; expect(facesOpenBeam(g.state, g.player)).toBe(true);
+    const close = buildGames('fire_close'); close.rival.tier = 4;
+    expect(facesOpenBeam(close.g.state, close.g.player)).toBe(false);
+  });
+
+  it('is bankable at tier II, past it only with the held rule, and off without the key', () => {
+    const { g } = buildGames('fire_heavy');
+    g.player.tier = 2; expect(tideWardBankable(g.player, g.state)).toBe(false);
+    withCounterRule({ tideWardBank: true }, () => {
+      expect(tideWardBankable(g.player, g.state)).toBe(true);
+      g.player.tier = 4; expect(tideWardBankable(g.player, g.state)).toBe(false);
+      withCounterRule({ tideWardHeld: true }, () => expect(tideWardBankable(g.player, g.state)).toBe(true));
+    });
+  });
+
+  it('spends nothing below Tide Ward\'s mana and keeps the mend line, then casts the ward at a seen beam', () => {
+    const { g, rival } = buildGames('fire_heavy'), s = g.state;
+    place(g.player, 10, 10); place(rival, 16, 10); g.player.tier = 2; rival.tier = 4;
+    g.player.mana = tideWard.mana + 1; g.player.hp = g.player.maxHp / 2;
+    const decide = () => { g.player.mageAI!.nextDecisionTick = s.tick; return mageInput(s, g.player); };
+    const before = decide();
+    expect(before.cast).toBe(true);
+    withCounterRule({ tideWardBank: true }, () => {
+      const banked = decide(), pick = waterSlotSpell(g.player, banked.slot, s)!;
+      if (banked.cast) {
+        expect(pick.line).not.toBe(tideWard.line);
+        expect(g.player.mana - (g.player.water.flow >= combat.flow.max ? combat.flow.crest.manaCost : pick.mana)).toBeGreaterThanOrEqual(tideWard.mana);
+      }
+      rival.pending = { kind: 'spell', startTick: s.tick, releaseTick: s.tick + 20, aim: { ...g.player.pos }, activationId: s.nextId++, spellId: 'fire_wrath' };
+      expect(decide()).toMatchObject({ slot: mendSlot, cast: true });
+    });
+  });
+});
+
+describe('Tide Ward at the windup (6.6)', () => {
+  // The Mirror tide reference past tier II against fire_heavy with Brand Wrath open, the held rule on (the ward is castable
+  // while a beam runs), decisions parked so only the off-cadence press can cast.
+  const setup = () => {
+    const { g, rival } = buildGames('fire_heavy'), s = g.state;
+    place(g.player, 10, 10); place(rival, 16, 10); g.player.tier = 4; rival.tier = 4; g.player.mana = g.player.maxMana;
+    const park = () => { g.player.mageAI!.nextDecisionTick = s.tick + 1e6; };
+    const beam = () => { s.schoolEffects = [{ id: s.nextId++, ownerId: rival.id, activationId: s.nextId++, spellId: 'fire_wrath', kind: 'beam', startTick: s.tick,
+      nextTick: s.tick + 5, endTick: s.tick + 120, origin: { ...rival.pos }, target: { ...g.player.pos }, damage: 14, family: 'magic', tier: 4, hitLog: [], lengthM: 10 }]; };
+    rival.facing = { x: -1, y: 0 };
+    return { g, rival, s, park, beam };
+  };
+  const wardPress = (i: { slot: number; cast: boolean }) => i.cast && i.slot === mendSlot;
+
+  it('is on only with the key, for a Water actor, outside canonical balance', () => {
+    const { g, rival, s } = setup();
+    expect(tideWardAtWindup(g.player, s)).toBe(false);
+    withCounterRule({ tideWardWindup: true }, () => {
+      expect(tideWardAtWindup(g.player, s)).toBe(true);
+      expect(tideWardAtWindup(rival, s)).toBe(false);
+      s.balance = 'canonical'; expect(tideWardAtWindup(g.player, s)).toBe(false); s.balance = undefined;
+    });
+  });
+
+  it('raises the ward off cadence once the reaction delay has run from the windup, and only then', () => {
+    const { g, rival, s, park, beam } = setup();
+    withCounterRule({ tideWardHeld: true, tideWardWindup: true }, () => {
+      rival.pending = { kind: 'spell', startTick: s.tick, releaseTick: s.tick + 12, aim: { ...g.player.pos }, activationId: s.nextId++, spellId: 'fire_wrath' };
+      const seenAt = s.tick; park();
+      expect(wardPress(mageInput(s, g.player))).toBe(false);
+      expect(g.player.mageAI!.wardCue).toMatchObject({ dueTick: expect.any(Number), done: false });
+      const due = g.player.mageAI!.wardCue!.dueTick;
+      expect(due).toBeGreaterThan(seenAt);
+      // The windup releases into the channel before the reaction has run; the cue outlives it.
+      s.tick += 12; rival.pending = undefined; beam();
+      for (; s.tick < due; s.tick++) { park(); expect(wardPress(mageInput(s, g.player))).toBe(false); }
+      park(); expect(wardPress(mageInput(s, g.player))).toBe(true);
+    });
+  });
+
+  it('never raises the ward at a beam first seen in its channel, where the held rule alone would', () => {
+    const { g, s, beam } = setup();
+    beam();
+    const decide = () => { g.player.mageAI!.nextDecisionTick = s.tick; return mageInput(s, g.player); };
+    withCounterRule({ tideWardHeld: true }, () => expect(decide()).toMatchObject({ slot: mendSlot, cast: true }));
+    withCounterRule({ tideWardHeld: true, tideWardWindup: true }, () => {
+      for (let i = 0; i < ticks(1); i++, s.tick++) expect(wardPress(decide())).toBe(false);
+      expect(g.player.mageAI!.wardCue).toBeUndefined();
+    });
+  });
+
+  it('drops a cue whose cadence passed without a castable ward', () => {
+    const { g, rival, s, park, beam } = setup();
+    withCounterRule({ tideWardHeld: true, tideWardWindup: true }, () => {
+      g.player.water.cooldowns[tideWard.line] = s.tick + ticks(30);
+      rival.pending = { kind: 'spell', startTick: s.tick, releaseTick: s.tick + 12, aim: { ...g.player.pos }, activationId: s.nextId++, spellId: 'fire_wrath' };
+      park(); mageInput(s, g.player);
+      s.tick += 12; rival.pending = undefined; beam();
+      for (let i = 0; i < ticks(2); i++, s.tick++) { park(); expect(wardPress(mageInput(s, g.player))).toBe(false); }
+      expect(g.player.mageAI!.wardCue!.done).toBe(true);
+      g.player.water.cooldowns[tideWard.line] = 0;
+      for (let i = 0; i < ticks(1); i++, s.tick++) { park(); expect(wardPress(mageInput(s, g.player))).toBe(false); }
+    });
+  });
+});
