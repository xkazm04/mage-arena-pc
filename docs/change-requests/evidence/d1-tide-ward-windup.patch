@@ -0,0 +1,37 @@
+// D1 6.4-6.5 Tide Ward probe: at the start of every aimed beam on the Mirror tide reference, can it afford Tide Ward (mana)
+// and is its mend line off cooldown? `npx tsx scripts/tide-ward-probe.ts [held|held-bank|windup-held|windup-bank-held]` plants
+// option A (default), A with the 6.5 bank, or either with the 6.6 windup cue. It also counts the Tide Ward releases, those made inside a beam start's window (both in hand), and the
+// beam blows that landed on the reference in all and while the ward was up.
+import { createGames, presets, runtime, stepGames, tapContacts, threats, ticks } from '../src/arena/index.ts';
+import { rivalBuilds } from '../src/arena/archetypes.ts';
+import { tideWard, withCounterRule } from '../src/arena/counters.ts';
+const arm = process.argv[2] ?? 'held'; if (!['held', 'held-bank', 'windup-held', 'windup-bank-held'].includes(arm)) throw Error('arm: held | held-bank | windup-held | windup-bank-held');
+const out: Record<string, unknown> = {};
+withCounterRule({ tideWardHeld: true, tideWardBank: arm.includes('bank'), tideWardWindup: arm.startsWith('windup') }, () => {
+  for (const id of ['fire_heavy', 'air_close', 'air_heavy']) {
+    let beams = 0, mana = 0, free = 0, both = 0, casts = 0, castsAtBeam = 0, beamBlows = 0, beamBlowsWarded = 0; const manas: number[] = [];
+    for (let i = 0; i < 200; i++) {
+      const g = createGames(runtime.games.censusSeedStart + i, presets.find(p => p.name === 'Mirror tide')!, rivalBuilds[id]!.wave, true, undefined, undefined, undefined, { rivalBuild: id });
+      let inBeam = false;
+      const untap = tapContacts(g.state, (s, target, hit) => {
+        if (target !== g.player || !(s.schoolEffects ?? []).some(e => e.kind === 'beam' && e.ownerId === hit.ownerId)) return;
+        beamBlows++; beamBlowsWarded += +(s.tick < g.player.water.wardUntil);
+      });
+      while (g.phase === 'active' && g.state.tick < ticks(runtime.games.fightTimeoutS)) {
+        const before = g.state.events.length; stepGames(g);
+        for (const e of g.state.events.slice(before)) if (e.kind === 'release' && e.actorId === g.player.id && e.spellId === tideWard.id) { casts++; castsAtBeam += +inBeam; }
+        const beam = threats(g.state, g.player).some(t => t.shape === 'beam' && t.aimedAtUs);
+        if (beam && !inBeam) {
+          beams++; manas.push(g.player.mana);
+          const ok = g.player.mana >= tideWard.mana, off = (g.player.water.cooldowns[tideWard.line] ?? 0) <= g.state.tick;
+          mana += +ok; free += +off; both += +(ok && off);
+        }
+        inBeam = beam;
+      }
+      untap();
+    }
+    manas.sort((a, b) => a - b);
+    out[id] = { beams, affordable: mana, mendLineFree: free, both, medianMana: manas[Math.floor(manas.length / 2)] ?? null, casts, castsAtBeam, beamBlows, beamBlowsWarded };
+  }
+});
+console.log(JSON.stringify({ arm, tideWardMana: tideWard.mana, seeds: 200, ...out }, null, 2));
