{
  "name": "@mage-arena/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./arena": "./src/arena/index.ts"
  },
  "scripts": {
    "data": "node scripts/compile-arena-data.mjs",
    "build": "npm run data && tsc -p tsconfig.arena.json",
