{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "declaration": true,
    "outDir": "dist/arena", "rootDir": "src/arena", "lib": ["ES2022"]
  },
  "include": ["src/arena/**/*.ts"], "exclude": ["src/arena/**/*.test.ts"]
}
